<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_scanner" model="ir.module.category">
        <field name="name">Scanner</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_scanner_manager" model="res.groups">
        <field name="name">Scanner Manager</field>
        <field name="category_id" ref="module_category_scanner"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="scanner_job_rule_user" model="ir.rule">
        <field name="name">Users can access their scanner jobs</field>
        <field name="model_id" ref="model_scanner_job"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="scanner_job_rule_manager" model="ir.rule">
        <field name="name">Scanner managers can access all jobs</field>
        <field name="model_id" ref="model_scanner_job"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_scanner_manager'))]"/>
    </record>
</odoo>
