<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="scanner_job_view_tree" model="ir.ui.view">
        <field name="name">scanner.job.tree</field>
        <field name="model">scanner.job</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'completed'"
                  decoration-danger="state == 'failed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="user_id"/>
                <field name="state" widget="badge"/>
                <field name="dpi"/>
                <field name="color_mode"/>
                <field name="source"/>
                <field name="create_date"/>
                <field name="completed_at"/>
            </tree>
        </field>
    </record>

    <record id="scanner_job_view_form" model="ir.ui.view">
        <field name="name">scanner.job.form</field>
        <field name="model">scanner.job</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_cancel" type="object" string="Cancel"
                            class="btn-secondary"
                            invisible="state in ('completed', 'cancelled')"/>
                    <button name="action_retry" type="object" string="Retry"
                            class="btn-primary"
                            invisible="state not in ('failed', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="request_uid"/>
                            <field name="request_model"/>
                            <field name="request_res_id"/>
                            <field name="request_field"/>
                        </group>
                        <group>
                            <field name="dpi"/>
                            <field name="color_mode"/>
                            <field name="source"/>
                            <field name="duplex"/>
                            <field name="output_format"/>
                        </group>
                    </group>
                    <group string="Result">
                        <field name="result_filename"/>
                        <field name="result_mimetype"/>
                        <field name="result" filename="result_filename"/>
                    </group>
                    <group string="Error" invisible="not error_code and not error_message">
                        <field name="error_code"/>
                        <field name="error_message"/>
                    </group>
                    <group string="Timing">
                        <field name="create_date"/>
                        <field name="claimed_at"/>
                        <field name="started_at"/>
                        <field name="completed_at"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="scanner_job_view_search" model="ir.ui.view">
        <field name="name">scanner.job.search</field>
        <field name="model">scanner.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="state"/>
                <filter name="my_jobs" string="My Jobs" domain="[('user_id', '=', uid)]"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_scanner_job" model="ir.actions.act_window">
        <field name="name">Scanner Jobs</field>
        <field name="res_model">scanner.job</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="scanner_job_view_search"/>
    </record>

    <menuitem id="menu_scanner_root" name="Scanner" sequence="60"
              groups="base.group_user"/>
    <menuitem id="menu_scanner_jobs" name="Scanner Jobs"
              parent="menu_scanner_root"
              action="action_scanner_job"
              sequence="20"
              groups="web_binary_camera_scanner.group_scanner_manager"/>
</odoo>
