<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="scanner_test_wizard_view_form" model="ir.ui.view">
        <field name="name">scanner.test.wizard.form</field>
        <field name="model">scanner.test.wizard</field>
        <field name="arch" type="xml">
            <form string="Scanner Gateway Test">
                <sheet>
                    <div class="oe_title">
                        <h1>Scanner Gateway Test</h1>
                    </div>
                    <p class="text-muted">
                        This screen creates a real scanner.job and waits for the external Scanner Gateway.
                    </p>
                    <group>
                        <field name="document"
                               filename="document_filename"
                               widget="binary_camera_scanner"/>
                        <field name="document_filename" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_scanner_test_wizard" model="ir.actions.act_window">
        <field name="name">Gateway Test</field>
        <field name="res_model">scanner.test.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_scanner_virtual_test"
              name="Gateway Test"
              parent="menu_scanner_root"
              action="action_scanner_test_wizard"
              sequence="10"
              groups="base.group_user"/>
</odoo>
